# =============================================================================
# DADAN environment configuration
#
# Local development: copy to .env and adjust. Defaults below target local dev
# (Postgres/Redis from `docker compose up -d`, apps via `pnpm dev`).
#
# Production (docker-compose.prod.yml): see docs/DEPLOYMENT.md. The prod compose
# file reads this same .env; variables marked [PROD] below are only used there.
# =============================================================================

# --- Database & cache ---
DATABASE_URL=postgresql://dadan:dadan@localhost:5433/dadan
REDIS_URL=redis://localhost:6379
# [PROD] Password for the Postgres container in docker-compose.prod.yml.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Secrets ---
# JWT_SECRET must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-secure-32-char-secret
# HMAC secret for certificate verification tokens (min 16 chars).
# Generate with: openssl rand -base64 32
CERT_SIGNING_SECRET=change-me-cert-signing-secret
HOUSE_KEY_SALT=12

# --- Sessions & cookies ---
# Client refresh token lifetime in days; access tokens use ACCESS_TOKEN_MINUTES
CLIENT_SESSION_DAYS=7
# Short-lived access JWT lifetime in minutes (refresh token handles renewal)
ACCESS_TOKEN_MINUTES=15
# Admin refresh token lifetime in hours (admin access tokens use ACCESS_TOKEN_MINUTES)
ADMIN_REFRESH_HOURS=24
# Set COOKIE_SECURE=true when running behind HTTPS/TLS proxy, false for HTTP-only
COOKIE_SECURE=false
# Per-IP rate limit for house-key validation and admin login (default 5 / 15 min).
# CI/E2E sets AUTH_RATE_LIMIT_MAX=100 so Playwright login attempts don't trip the limit.
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# --- Web <-> API routing ---
# API_URL: where the Next.js server reaches the API (SSR + /backend rewrite).
#   Local dev: http://localhost:4000 | Prod compose sets this to http://api:4000.
API_URL=http://localhost:4000
# NEXT_PUBLIC_API_URL: browser-side API base path (baked into the client bundle
# at build time).
#   Local dev: /backend  (handled by the Next.js rewrite in next.config.ts)
#   Production: /api     (handled by nginx; docker-compose.prod.yml passes it
#                         as a build arg automatically - do not change here)
NEXT_PUBLIC_API_URL=/backend
# Public origin of the web app (CORS allowlist + certificate verify links).
# In production set BOTH to your public URL, e.g. https://example.com
WEB_ORIGIN=http://localhost:3000
BASE_URL=http://localhost:3000

# --- Storage provider ---
# local: files stored on the VPS at STORAGE_LOCAL_PATH (default /app/uploads).
# Future options: s3, r2, hetzner (when S3_* vars are also set).
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/uploads
# Directory that holds the seed catalog images (collection-N.avif, product-N.avif).
# The seeder defaults to apps/web/public/seeder-assets relative to the repo;
# in the production container it is set to /app/seeder-assets by
# scripts/seed-production.sh. Only needed when overriding the default.
SEED_ASSETS_DIR=

# --- Payments (Tap Payments — https://www.tap.company) ---
# Tap secret API key (sk_test_... or sk_live_...). Required in production;
# leave empty in dev to use the built-in mock provider.
PAYMENT_PROVIDER_KEY=
# Optional dedicated webhook signing secret; defaults to the secret API key
# (Tap signs webhook hashstrings with the merchant secret key).
PAYMENT_PROVIDER_SECRET=
# Public URL Tap should POST charge webhooks to, e.g.
# https://example.com/api/payments/webhook. Leave empty to disable webhooks.
PAYMENT_WEBHOOK_URL=
# VAT rate applied at checkout (0.15 = 15%). Must match your tax jurisdiction.
# Used by the API for the charged total and by the web build for the display.
VAT_RATE=0.15
# Web checkout mode: "mock" uses the mock gateway token; "live" renders the
# real Tap Web Card SDK (requires NEXT_PUBLIC_TAP_PUBLIC_KEY below).
NEXT_PUBLIC_PAYMENT_MODE=mock
# Tap public/publishable key (pk_test_... or pk_live_...) — safe to expose to
# the browser; used by the Web Card SDK to tokenize card details client-side.
# Only required when NEXT_PUBLIC_PAYMENT_MODE=live.
# IMPORTANT: Tap only allows tokenization from domains registered with them.
# Email integrations@tap.company to whitelist your hosting domain(s) before
# going live, or tokenization will fail silently in the browser.
NEXT_PUBLIC_TAP_PUBLIC_KEY=
# Tap merchant ID, required by the Card SDK's `merchant.id` config field.
# Found in the Tap dashboard under Merchant/Business settings.
NEXT_PUBLIC_TAP_MERCHANT_ID=

# --- Email (optional; if unset, emails are logged instead of sent) ---
ADMIN_EMAIL=admin@dadan.sa
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Misc ---
PDF_WATERMARK_TEXT=DADAN DIJITAL — AUTHENTICATED
# [PROD] Host port nginx listens on (default 80)
HTTP_PORT=80

REDIS_PASSWORD=
