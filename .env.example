# =============================================================================
# DADAN environment configuration
#
# Local development: copy to .env and adjust. Defaults below target local dev
# (Postgres/Redis from `docker compose up -d`, apps via `pnpm dev`).
#
# Production (docker-compose.prod.yml): see docs/DEPLOYMENT.md. The prod compose
# file reads this same .env; variables marked [PROD] below are only used there.
# =============================================================================

# --- Database & cache ---
DATABASE_URL=postgresql://dadan:dadan@localhost:5433/dadan
REDIS_URL=redis://localhost:6379
# [PROD] Password for the Postgres container in docker-compose.prod.yml.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Secrets ---
# JWT_SECRET must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-secure-32-char-secret
# HMAC secret for certificate verification tokens (min 16 chars).
# Generate with: openssl rand -base64 32
CERT_SIGNING_SECRET=change-me-cert-signing-secret
HOUSE_KEY_SALT=12

# --- Sessions & cookies ---
# Client session lifetime in days (JWT expiry); admin sessions are fixed at 24h
CLIENT_SESSION_DAYS=7
# Set COOKIE_SECURE=true when running behind HTTPS/TLS proxy, false for HTTP-only
COOKIE_SECURE=false

# --- Web <-> API routing ---
# API_URL: where the Next.js server reaches the API (SSR + /backend rewrite).
#   Local dev: http://localhost:4000 | Prod compose sets this to http://api:4000.
API_URL=http://localhost:4000
# NEXT_PUBLIC_API_URL: browser-side API base path (baked into the client bundle
# at build time).
#   Local dev: /backend  (handled by the Next.js rewrite in next.config.ts)
#   Production: /api     (handled by nginx; docker-compose.prod.yml passes it
#                         as a build arg automatically - do not change here)
NEXT_PUBLIC_API_URL=/backend
# Public origin of the web app (CORS allowlist + certificate verify links).
# In production set BOTH to your public URL, e.g. https://example.com
WEB_ORIGIN=http://localhost:3000
BASE_URL=http://localhost:3000

# --- Object storage (Cloudflare R2, required) ---
# Create bucket + API token in the Cloudflare dashboard (see docs/DEPLOYMENT.md)
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=dadan-assets-dev
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key
S3_REGION=auto

# --- Payments ---
# Stripe secret key (sk_test_... or sk_live_...). Required in production;
# leave empty in dev to use the built-in mock provider.
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
# VAT rate applied at checkout (0.15 = 15%). Must match your tax jurisdiction.
# Used by the API for the charged total and by the web build for the display.
VAT_RATE=0.15
# Web checkout mode: "mock" uses the mock gateway token; anything else disables
# online checkout until a real payment element (Stripe Elements) is integrated.
NEXT_PUBLIC_PAYMENT_MODE=mock

# --- Email (optional; if unset, emails are logged instead of sent) ---
ADMIN_EMAIL=admin@dadan.sa
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Misc ---
PDF_WATERMARK_TEXT=DADAN DIJITAL — AUTHENTICATED
# [PROD] Host port nginx listens on (default 80)
HTTP_PORT=80
