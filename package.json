{
  "name": "dadan-dijital",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    },
    "overrides": {
      "browserslist": "^4.28.7",
      "tar": "^7.5.21",
      "multer": "^2.2.0",
      "deepmerge-ts": "^8.0.2",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "fast-uri": "^3.1.6",
      "undici": "^7.29.0",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.17",
      "postcss": "^8.5.23",
      "sharp": "^0.35.3"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:seed": "pnpm --filter @dadan/db db:seed",
    "db:seed:reset": "pnpm --filter @dadan/db db:seed:reset",
    "seed:catalog": "pnpm --filter @dadan/db db:seed",
    "seed:catalog:reset": "pnpm --filter @dadan/db db:seed:reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "turbo": "^2.10.7"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,cjs,mjs}": "bash -c 'ESLINT_USE_FLAT_CONFIG=false eslint --fix \"$@\"' _",
    "*.{json,md,yaml,yml}": "prettier --write"
  }
}
