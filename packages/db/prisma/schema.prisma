generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum PieceStatus {
  AVAILABLE
  OWNED
  TRANSFER_PENDING
  RETIRED
}

enum AcquisitionType {
  PURCHASE
  GIFT
  INHERITANCE
  ADMIN_ASSIGNMENT
}

enum TransferType {
  SALE
  GIFT
  INHERITANCE
}

enum TransferStatus {
  INITIATED
  SENDER_CONFIRMED
  RECIPIENT_CONFIRMED
  DADAN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

enum VerificationResult {
  FOUND
  NOT_FOUND
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
  CURATOR
  OPERATIONS
  VIEWER
}

enum StaffRequestType {
  ACCESS_REQUEST
  MEMBERSHIP_UPGRADE
  KEY_ISSUANCE
}

enum StaffRequestStatus {
  PENDING
  UNDER_REVIEW
  COMPLETED
  REJECTED
}

enum ActorType {
  CLIENT
  ADMIN
  SYSTEM
}

// --- Models ---

model Class {
  id          String   @id @default(uuid())
  name        String
  nameAr      String?
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients     Client[]
  collections CollectionClass[]

  @@index([isDefault])
  @@index([isActive, sortOrder])
}

model CollectionClass {
  collectionId String
  classId      String

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([collectionId, classId])
  @@index([classId])
}

model Client {
  id             String   @id @default(uuid())
  /// Shareable 6-character identifier for transfers (e.g., "A7X9B2"). NOT the login credential.
  houseId        String   @unique
  houseKey       String   @unique
  houseKeyPrefix String
  displayName    String
  email          String   @unique
  phone          String?
  locale         String   @default("ar")
  isActive       Boolean  @default(true)
  classId        String
  lastSeenAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class                 Class                 @relation(fields: [classId], references: [id])
  ownedPieces           Piece[]               @relation("PieceOwner")
  savedPieces           SavedPiece[]
  sentTransfers         TransferRequest[]     @relation("TransferSender")
  receivedTransfers     TransferRequest[]     @relation("TransferRecipient")
  verificationLogs      VerificationLog[]
  orders                Order[]
  ownershipRecords      OwnershipRecord[]
  certificates          Certificate[]
  cartItems             CartItem[]
  checkoutReservations  CheckoutReservation[]
  staffRequests         StaffRequest[]

  @@index([houseKeyPrefix, isActive])
  @@index([classId])
  @@index([isActive, classId])
  @@index([createdAt(sort: Desc)])
  @@index([lastSeenAt])
}

model Collection {
  id               String   @id @default(uuid())
  name             String
  /// Arabic name; falls back to `name` when null.
  nameAr           String?
  slug             String   @unique
  description      String?
  /// Arabic description; falls back to `description` when null.
  descriptionAr    String?
  coverImageUrl    String?
  /// Low-quality image placeholder data URL (base64) for blur-up loading.
  coverImageLqip   String?
  isVisible        Boolean  @default(true)
  sortOrder        Int      @default(0)
  viewCount        Int      @default(0)
  origin           String?  @db.Text
  originAr         String?  @db.Text
  meaning          String?  @db.Text
  meaningAr        String?  @db.Text
  inspiration      String?  @db.Text
  inspirationAr    String?  @db.Text
  storyContent     String?  @db.Text
  storyContentAr   String?  @db.Text
  storyImageUrls   String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  classes       CollectionClass[]
  pieces        Piece[]
  staffRequests StaffRequest[]

  @@index([isVisible, sortOrder])
  @@index([updatedAt])
}

model Piece {
  id             String      @id @default(uuid())
  serialNumber   String      @unique
  collectionId   String
  currentOwnerId String?
  status         PieceStatus @default(AVAILABLE)
  registeredAt   DateTime    @default(now())
  name           String
  /// Arabic name; falls back to `name` when null.
  nameAr         String?
  slug           String      @unique
  story          String      @db.Text
  /// Arabic story; falls back to `story` when null.
  storyAr        String?     @db.Text
  material       String
  /// Arabic material; falls back to `material` when null.
  materialAr     String?
  weight         Decimal     @db.Decimal(10, 3)
  dimensions     String
  /// Arabic dimensions; falls back to `dimensions` when null.
  dimensionsAr   String?
  imageUrls      String[]
  /// Low-quality image placeholder data URLs (base64) for blur-up loading.
  imageLqips     String[]
  price          Decimal     @db.Decimal(12, 2)
  currency       String      @default("SAR")
  notes          String?     @db.Text
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  collection          Collection           @relation(fields: [collectionId], references: [id])
  currentOwner        Client?              @relation("PieceOwner", fields: [currentOwnerId], references: [id])
  specifications      PieceSpecification[]
  ownershipRecords    OwnershipRecord[]
  certificates        Certificate[]
  transferRequests    TransferRequest[]
  verificationLogs    VerificationLog[]
  orderItems          OrderItem[]
  savedByClients      SavedPiece[]
  cartItems           CartItem[]
  checkoutReservation CheckoutReservation?

  @@index([currentOwnerId])
  @@index([collectionId, status])
  @@index([collectionId, isActive])
  @@index([status, createdAt])
  @@index([isActive, collectionId])
  @@index([updatedAt])
}

model PieceSpecification {
  id        String  @id @default(uuid())
  pieceId   String
  key       String
  /// Arabic label; falls back to `key` when null.
  keyAr     String?
  value     String
  /// Arabic value; falls back to `value` when null.
  valueAr   String?
  sortOrder Int     @default(0)

  piece Piece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@unique([pieceId, key])
}

/// Append-only ownership history — never delete records (enforce in service layer).
model OwnershipRecord {
  id              String          @id @default(uuid())
  pieceId         String
  clientId        String
  acquiredAt      DateTime        @default(now())
  transferredAt   DateTime?
  acquisitionType AcquisitionType
  notes           String?
  certificateId   String?

  piece       Piece        @relation(fields: [pieceId], references: [id])
  client      Client       @relation(fields: [clientId], references: [id])
  certificate Certificate? @relation(fields: [certificateId], references: [id])

  @@index([pieceId, transferredAt])
  @@index([clientId])
  @@index([acquiredAt])
}

model Certificate {
  id                String   @id @default(uuid())
  pieceId           String
  ownerId           String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  isActive          Boolean  @default(true)
  pdfUrl            String?
  qrCodeData        String
  templateVersion   String   @default("1.0")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  piece            Piece             @relation(fields: [pieceId], references: [id])
  owner            Client            @relation(fields: [ownerId], references: [id])
  ownershipRecords OwnershipRecord[]

  @@index([pieceId, isActive])
  @@index([isActive, issuedAt])
  @@index([ownerId])
}

model Order {
  id                String            @id @default(uuid())
  clientId          String
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  /// Subtotal before tax and shipping
  subtotalAmount    Decimal           @db.Decimal(12, 2)
  /// Tax amount (VAT)
  taxAmount         Decimal           @db.Decimal(12, 2)
  /// Tax rate at time of purchase (e.g., 0.15 for 15% VAT)
  taxRate           Decimal           @db.Decimal(5, 4)
  /// Shipping cost
  shippingAmount    Decimal           @default(0) @db.Decimal(12, 2)
  /// Discount amount applied
  discountAmount    Decimal           @default(0) @db.Decimal(12, 2)
  /// Final total (subtotal + tax + shipping - discount)
  totalAmount       Decimal           @db.Decimal(12, 2)
  currency          String            @default("SAR")
  paymentProvider   String
  paymentMethod     String?
  paymentReference  String?
  /// Idempotency key for payment operations
  idempotencyKey    String?           @unique
  shippingAddress   Json
  placedAt          DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  client Client      @relation(fields: [clientId], references: [id])
  items  OrderItem[]

  @@index([clientId, status])
  @@index([clientId, placedAt(sort: Desc)])
  @@index([paymentReference])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([placedAt(sort: Desc)])
  @@index([status, placedAt])
}

model OrderItem {
  id                     String  @id @default(uuid())
  orderId                String
  pieceId                String
  /// Unit price at time of purchase
  priceAtPurchase        Decimal @db.Decimal(12, 2)
  /// Tax rate applied to this item
  taxRate                Decimal @default(0.15) @db.Decimal(5, 4)
  /// Tax amount for this item
  taxAmount              Decimal @default(0) @db.Decimal(12, 2)
  /// Any discount applied to this item
  discountAmount         Decimal @default(0) @db.Decimal(12, 2)
  /// Line total (priceAtPurchase + taxAmount - discountAmount)
  lineTotal              Decimal @db.Decimal(12, 2)
  currency               String  @default("SAR")
  nameSnapshot           String
  collectionNameSnapshot String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  piece Piece @relation(fields: [pieceId], references: [id])

  @@index([pieceId])
}

model SavedPiece {
  clientId String
  pieceId  String
  savedAt  DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  piece  Piece  @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@id([clientId, pieceId])
}

/// Transfer status transitions are forward-only (enforce in service layer).
model TransferRequest {
  id                   String         @id @default(uuid())
  pieceId              String
  fromClientId         String
  toClientId           String
  transferType         TransferType
  status               TransferStatus @default(INITIATED)
  senderConfirmedAt    DateTime?
  recipientConfirmedAt DateTime?
  dadanReviewedAt      DateTime?
  dadanReviewedBy      String?
  dadanNotes           String?
  initiatedAt          DateTime       @default(now())
  completedAt          DateTime?

  piece      Piece      @relation(fields: [pieceId], references: [id])
  fromClient Client     @relation("TransferSender", fields: [fromClientId], references: [id])
  toClient   Client     @relation("TransferRecipient", fields: [toClientId], references: [id])
  reviewedBy AdminUser? @relation(fields: [dadanReviewedBy], references: [id])

  @@index([pieceId, status])
  @@index([fromClientId])
  @@index([toClientId])
  @@index([status])
  @@index([status, initiatedAt(sort: Desc)])
}

model VerificationLog {
  id           String             @id @default(uuid())
  pieceId      String?
  serialNumber String
  verifiedAt   DateTime           @default(now())
  ipAddress    String?
  clientId     String?
  result       VerificationResult

  piece  Piece?  @relation(fields: [pieceId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([serialNumber])
  @@index([result, verifiedAt])
  @@index([verifiedAt])
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transfersReviewed TransferRequest[]
  staffRequestsReviewed StaffRequest[]

  @@index([isActive, role])
}

model AuditLog {
  id         String    @id @default(uuid())
  actorType  ActorType
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}

model CartItem {
  id       String   @id @default(uuid())
  clientId String
  pieceId  String
  addedAt  DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  piece  Piece  @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@unique([clientId, pieceId])
  @@index([clientId])
}

model CheckoutReservation {
  id        String   @id @default(uuid())
  clientId  String
  pieceId   String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  piece  Piece  @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}

model FailedRefund {
  id                String    @id @default(uuid())
  clientId          String
  providerReference String
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("SAR")
  reason            String
  attempts          Int       @default(0)
  lastError         String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([resolvedAt])
}

model HouseSettings {
  id                     String   @id
  houseName              String
  description            String?
  contactEmail           String?
  supportContact         String?
  locale                 String   @default("ar")
  timezone               String   @default("Asia/Riyadh")
  privateHouseAccess     Boolean  @default(true)
  privateKeyRequired     Boolean  @default(true)
  adminApprovalRequired  Boolean  @default(true)
  allowInvitations       Boolean  @default(true)
  keyValidityMonths      Int      @default(12)
  requireKeyRenewal      Boolean  @default(true)
  notificationPrefs      Json
  updatedAt              DateTime @updatedAt
}

model StaffRequest {
  id             String             @id @default(uuid())
  requestNumber  String             @unique
  type           StaffRequestType
  status         StaffRequestStatus @default(PENDING)
  clientId       String
  targetClassId  String?
  collectionId   String?
  notes          String?
  reviewNotes    String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  client     Client     @relation(fields: [clientId], references: [id])
  collection Collection? @relation(fields: [collectionId], references: [id])
  reviewedBy AdminUser?  @relation(fields: [reviewedById], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([type, status])
  @@index([clientId])
}
