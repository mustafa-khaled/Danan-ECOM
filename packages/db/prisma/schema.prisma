generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum PieceStatus {
  AVAILABLE
  OWNED
  TRANSFER_PENDING
  RETIRED
}

enum AcquisitionType {
  PURCHASE
  GIFT
  INHERITANCE
  ADMIN_ASSIGNMENT
}

enum TransferType {
  SALE
  GIFT
  INHERITANCE
}

enum TransferStatus {
  INITIATED
  SENDER_CONFIRMED
  RECIPIENT_CONFIRMED
  DADAN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

enum VerificationResult {
  FOUND
  NOT_FOUND
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
  VIEWER
}

enum ActorType {
  CLIENT
  ADMIN
  SYSTEM
}

// --- Models ---

model Client {
  id               String   @id @default(uuid())
  houseKey         String   @unique
  houseKeyPrefix   String
  displayName      String
  email            String   @unique
  phone            String?
  locale           String   @default("ar")
  isActive         Boolean  @default(true)
  visibilityGroups String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownedPieces       Piece[]           @relation("PieceOwner")
  savedPieces       SavedPiece[]
  sentTransfers     TransferRequest[] @relation("TransferSender")
  receivedTransfers TransferRequest[] @relation("TransferRecipient")
  verificationLogs  VerificationLog[]
  orders            Order[]
  ownershipRecords  OwnershipRecord[]
  certificates      Certificate[]
  cartItems         CartItem[]

  @@index([houseKeyPrefix, isActive])
}

model Collection {
  id               String   @id @default(uuid())
  name             String
  /// Arabic name; falls back to `name` when null.
  nameAr           String?
  slug             String   @unique
  description      String?
  /// Arabic description; falls back to `description` when null.
  descriptionAr    String?
  coverImageUrl    String?
  /// Low-quality image placeholder data URL (base64) for blur-up loading.
  coverImageLqip   String?
  isVisible        Boolean  @default(true)
  sortOrder        Int      @default(0)
  visibilityGroups String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  designs Design[]
}

model Design {
  id               String   @id @default(uuid())
  name             String
  /// Arabic name; falls back to `name` when null.
  nameAr           String?
  slug             String   @unique
  collectionId     String
  story            String   @db.Text
  /// Arabic story; falls back to `story` when null.
  storyAr          String?  @db.Text
  material         String
  /// Arabic material; falls back to `material` when null.
  materialAr       String?
  weight           Decimal  @db.Decimal(10, 3)
  dimensions       String
  /// Arabic dimensions; falls back to `dimensions` when null.
  dimensionsAr     String?
  imageUrls        String[]
  /// Low-quality image placeholder data URLs (base64) for blur-up loading.
  imageLqips       String[]
  basePrice        Decimal  @db.Decimal(12, 2)
  currency         String   @default("SAR")
  isActive         Boolean  @default(true)
  visibilityGroups String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  collection     Collection            @relation(fields: [collectionId], references: [id])
  pieces         Piece[]
  specifications DesignSpecification[]
  orderItems     OrderItem[]

  @@index([collectionId])
}

model DesignSpecification {
  id        String  @id @default(uuid())
  designId  String
  key       String
  /// Arabic label; falls back to `key` when null.
  keyAr     String?
  value     String
  /// Arabic value; falls back to `value` when null.
  valueAr   String?
  sortOrder Int     @default(0)

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, key])
}

model Piece {
  id             String      @id @default(uuid())
  serialNumber   String      @unique
  designId       String
  currentOwnerId String?
  status         PieceStatus @default(AVAILABLE)
  registeredAt   DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  design           Design            @relation(fields: [designId], references: [id])
  currentOwner     Client?           @relation("PieceOwner", fields: [currentOwnerId], references: [id])
  ownershipRecords OwnershipRecord[]
  certificates     Certificate[]
  transferRequests TransferRequest[]
  verificationLogs VerificationLog[]
  orderItems       OrderItem[]
  savedByClients   SavedPiece[]
  cartItem         CartItem?

  @@index([currentOwnerId])
  @@index([designId, status])
}

/// Append-only ownership history — never delete records (enforce in service layer).
model OwnershipRecord {
  id              String          @id @default(uuid())
  pieceId         String
  clientId        String
  acquiredAt      DateTime        @default(now())
  transferredAt   DateTime?
  acquisitionType AcquisitionType
  notes           String?
  certificateId   String?

  piece       Piece        @relation(fields: [pieceId], references: [id])
  client      Client       @relation(fields: [clientId], references: [id])
  certificate Certificate? @relation(fields: [certificateId], references: [id])

  @@index([pieceId, transferredAt])
}

model Certificate {
  id                String   @id @default(uuid())
  pieceId           String
  ownerId           String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  isActive          Boolean  @default(true)
  pdfUrl            String?
  qrCodeData        String
  templateVersion   String   @default("1.0")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  piece            Piece             @relation(fields: [pieceId], references: [id])
  owner            Client            @relation(fields: [ownerId], references: [id])
  ownershipRecords OwnershipRecord[]

  @@index([pieceId, isActive])
}

model Order {
  id                String            @id @default(uuid())
  clientId          String
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  /// Subtotal before tax and shipping
  subtotalAmount    Decimal           @db.Decimal(12, 2)
  /// Tax amount (VAT)
  taxAmount         Decimal           @db.Decimal(12, 2)
  /// Tax rate at time of purchase (e.g., 0.15 for 15% VAT)
  taxRate           Decimal           @db.Decimal(5, 4)
  /// Shipping cost
  shippingAmount    Decimal           @default(0) @db.Decimal(12, 2)
  /// Discount amount applied
  discountAmount    Decimal           @default(0) @db.Decimal(12, 2)
  /// Final total (subtotal + tax + shipping - discount)
  totalAmount       Decimal           @db.Decimal(12, 2)
  currency          String            @default("SAR")
  paymentProvider   String
  paymentMethod     String?
  paymentReference  String?
  /// Idempotency key for payment operations
  idempotencyKey    String?           @unique
  shippingAddress   Json
  placedAt          DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  client Client      @relation(fields: [clientId], references: [id])
  items  OrderItem[]

  @@index([clientId, status])
  @@index([paymentReference])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  pieceId         String
  designId        String
  /// Unit price at time of purchase (base price from design)
  priceAtPurchase Decimal @db.Decimal(12, 2)
  /// Tax rate applied to this item
  taxRate         Decimal @default(0.15) @db.Decimal(5, 4)
  /// Tax amount for this item
  taxAmount       Decimal @default(0) @db.Decimal(12, 2)
  /// Any discount applied to this item
  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  /// Line total (priceAtPurchase + taxAmount - discountAmount)
  lineTotal       Decimal @db.Decimal(12, 2)
  currency        String  @default("SAR")

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  piece  Piece  @relation(fields: [pieceId], references: [id])
  design Design @relation(fields: [designId], references: [id])

  @@index([pieceId])
}

model SavedPiece {
  clientId String
  pieceId  String
  savedAt  DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  piece  Piece  @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@id([clientId, pieceId])
}

/// Transfer status transitions are forward-only (enforce in service layer).
model TransferRequest {
  id                   String         @id @default(uuid())
  pieceId              String
  fromClientId         String
  toClientId           String
  transferType         TransferType
  status               TransferStatus @default(INITIATED)
  senderConfirmedAt    DateTime?
  recipientConfirmedAt DateTime?
  dadanReviewedAt      DateTime?
  dadanReviewedBy      String?
  dadanNotes           String?
  initiatedAt          DateTime       @default(now())
  completedAt          DateTime?

  piece      Piece      @relation(fields: [pieceId], references: [id])
  fromClient Client     @relation("TransferSender", fields: [fromClientId], references: [id])
  toClient   Client     @relation("TransferRecipient", fields: [toClientId], references: [id])
  reviewedBy AdminUser? @relation(fields: [dadanReviewedBy], references: [id])

  @@index([pieceId, status])
  @@index([fromClientId])
  @@index([toClientId])
  @@index([status])
}

model VerificationLog {
  id           String             @id @default(uuid())
  pieceId      String?
  serialNumber String
  verifiedAt   DateTime           @default(now())
  ipAddress    String?
  clientId     String?
  result       VerificationResult

  piece  Piece?  @relation(fields: [pieceId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([serialNumber])
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transfersReviewed TransferRequest[]
}

model AuditLog {
  id         String    @id @default(uuid())
  actorType  ActorType
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}

model CartItem {
  id        String   @id @default(uuid())
  clientId  String
  pieceId   String   @unique
  addedAt   DateTime @default(now())
  expiresAt DateTime

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  piece  Piece  @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}

model FailedRefund {
  id                String    @id @default(uuid())
  clientId          String
  providerReference String
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("SAR")
  reason            String
  attempts          Int       @default(0)
  lastError         String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([resolvedAt])
}
