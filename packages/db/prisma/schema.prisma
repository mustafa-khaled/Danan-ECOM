generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum PieceStatus {
  AVAILABLE
  OWNED
  TRANSFER_PENDING
  RETIRED
}

enum AcquisitionType {
  PURCHASE
  GIFT
  INHERITANCE
  ADMIN_ASSIGNMENT
}

enum TransferType {
  SALE
  GIFT
  INHERITANCE
}

enum TransferStatus {
  INITIATED
  SENDER_CONFIRMED
  RECIPIENT_CONFIRMED
  DADAN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  FULFILLED
  CANCELLED
}

enum VerificationResult {
  FOUND
  NOT_FOUND
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
  VIEWER
}

enum ActorType {
  CLIENT
  ADMIN
  SYSTEM
}

// --- Models ---

model Client {
  id               String   @id @default(uuid())
  houseKey         String   @unique
  houseKeyPrefix   String
  displayName      String
  email            String   @unique
  phone            String?
  locale           String   @default("ar")
  isActive         Boolean  @default(true)
  visibilityGroups String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownedPieces      Piece[]            @relation("PieceOwner")
  savedPieces      SavedPiece[]
  sentTransfers    TransferRequest[]  @relation("TransferSender")
  receivedTransfers TransferRequest[] @relation("TransferRecipient")
  verificationLogs VerificationLog[]
  orders           Order[]
  ownershipRecords OwnershipRecord[]
  certificates     Certificate[]

  @@index([houseKeyPrefix, isActive])
}

model Collection {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?
  coverImageUrl    String?
  isVisible        Boolean  @default(true)
  sortOrder        Int      @default(0)
  visibilityGroups String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  designs Design[]
}

model Design {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  collectionId     String
  story            String   @db.Text
  material         String
  weight           Decimal  @db.Decimal(10, 3)
  dimensions       String
  imageUrls        String[]
  basePrice        Decimal  @db.Decimal(12, 2)
  currency         String   @default("SAR")
  isActive         Boolean  @default(true)
  visibilityGroups String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  collection     Collection            @relation(fields: [collectionId], references: [id])
  pieces         Piece[]
  specifications DesignSpecification[]
  orderItems     OrderItem[]

  @@index([collectionId])
}

model DesignSpecification {
  id        String @id @default(uuid())
  designId  String
  key       String
  value     String
  sortOrder Int    @default(0)

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)
}

model Piece {
  id             String      @id @default(uuid())
  serialNumber   String      @unique
  designId       String
  currentOwnerId String?
  status         PieceStatus @default(AVAILABLE)
  registeredAt   DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  design             Design              @relation(fields: [designId], references: [id])
  currentOwner       Client?             @relation("PieceOwner", fields: [currentOwnerId], references: [id])
  ownershipRecords   OwnershipRecord[]
  certificates       Certificate[]
  transferRequests   TransferRequest[]
  verificationLogs   VerificationLog[]
  orderItems         OrderItem[]
  savedByClients     SavedPiece[]

  @@index([currentOwnerId])
  @@index([designId, status])
}

/// Append-only ownership history — never delete records (enforce in service layer).
model OwnershipRecord {
  id              String          @id @default(uuid())
  pieceId         String
  clientId        String
  acquiredAt      DateTime        @default(now())
  transferredAt   DateTime?
  acquisitionType AcquisitionType
  notes           String?
  certificateId   String?

  piece       Piece        @relation(fields: [pieceId], references: [id])
  client      Client       @relation(fields: [clientId], references: [id])
  certificate Certificate? @relation(fields: [certificateId], references: [id])
}

model Certificate {
  id                String   @id @default(uuid())
  pieceId           String
  ownerId           String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  isActive          Boolean  @default(true)
  pdfUrl            String?
  qrCodeData        String
  templateVersion   String   @default("1.0")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  piece             Piece             @relation(fields: [pieceId], references: [id])
  owner             Client            @relation(fields: [ownerId], references: [id])
  ownershipRecords  OwnershipRecord[]

  @@index([pieceId, isActive])
}

model Order {
  id                String      @id @default(uuid())
  clientId          String
  status            OrderStatus @default(PENDING)
  totalAmount       Decimal     @db.Decimal(12, 2)
  currency          String      @default("SAR")
  paymentProvider   String
  paymentReference  String?
  shippingAddress   Json
  placedAt          DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  client Client      @relation(fields: [clientId], references: [id])
  items  OrderItem[]

  @@index([clientId, status])
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String
  pieceId          String
  designId         String
  priceAtPurchase  Decimal @db.Decimal(12, 2)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  piece  Piece  @relation(fields: [pieceId], references: [id])
  design Design @relation(fields: [designId], references: [id])
}

model SavedPiece {
  clientId String
  pieceId  String
  savedAt  DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  piece  Piece  @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@id([clientId, pieceId])
}

/// Transfer status transitions are forward-only (enforce in service layer).
model TransferRequest {
  id                   String         @id @default(uuid())
  pieceId              String
  fromClientId         String
  toClientId           String
  transferType         TransferType
  status               TransferStatus @default(INITIATED)
  senderConfirmedAt    DateTime?
  recipientConfirmedAt DateTime?
  dadanReviewedAt      DateTime?
  dadanReviewedBy      String?
  dadanNotes           String?
  initiatedAt          DateTime       @default(now())
  completedAt          DateTime?

  piece       Piece      @relation(fields: [pieceId], references: [id])
  fromClient  Client     @relation("TransferSender", fields: [fromClientId], references: [id])
  toClient    Client     @relation("TransferRecipient", fields: [toClientId], references: [id])
  reviewedBy  AdminUser? @relation(fields: [dadanReviewedBy], references: [id])

  @@index([pieceId, status])
  @@index([fromClientId])
  @@index([toClientId])
  @@index([status])
}

model VerificationLog {
  id           String             @id @default(uuid())
  pieceId      String?
  serialNumber String
  verifiedAt   DateTime           @default(now())
  ipAddress    String?
  clientId     String?
  result       VerificationResult

  piece  Piece?  @relation(fields: [pieceId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transfersReviewed TransferRequest[]
}

model AuditLog {
  id         String    @id @default(uuid())
  actorType  ActorType
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())
}

model CartItem {
  id        String   @id @default(uuid())
  clientId  String
  pieceId   String   @unique
  addedAt   DateTime @default(now())
  expiresAt DateTime

  @@index([clientId])
  @@index([expiresAt])
}
